# Copy to .env and fill in.
# Secret used to sign sessions. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the site.
BETTER_AUTH_URL=http://localhost:5173
# Path to the SQLite file (relative paths resolve from the project root).
DATABASE_URL=./data/workshop-europa.db
# Where the Areal font files live. Licensed, so they are not in the repository
# and not in the build — put them on the volume beside the database and point
# this at them. Absent, the site falls back to a system sans. See docs/fonts.md.
FONTS_DIR=./data/fonts
