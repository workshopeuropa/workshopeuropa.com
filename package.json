{
  "name": "workshopeuropa.com",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Workshop Europa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/workshopeuropa/workshopeuropa.com.git"
  },
  "license": "UNLICENSED",
  "scripts": {
    "dev": "bun run --bun vite dev",
    "build": "bun run --bun vite build",
    "preview": "bun run --bun vite preview",
    "start": "bun ./scripts/start.ts",
    "check": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "bun run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "i18n:compile": "paraglide-js compile --project ./project.inlang",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@eslym/sveltekit-adapter-bun": "^2.2.4",
    "@inlang/paraglide-js": "2.29.2",
    "@libsql/client": "^0.17.0",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/bun": "^1.4.3",
    "drizzle-kit": "^0.31.10",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^6.0.3",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@fontsource/spectral": "^5.3.0",
    "better-auth": "^1.6.26",
    "drizzle-orm": "^0.45.2"
  }
}
